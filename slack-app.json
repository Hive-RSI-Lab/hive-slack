{
  "_metadata": {"major_version": 1, "minor_version": 1},
  "display_information": {
    "name": "Hive",
    "description": "Talk to your Hive's lead, project leads and running agents.",
    "background_color": "#2c2d30"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {"display_name": "Hive", "always_online": true}
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "channels:history", "groups:history", "im:history",
        "channels:read", "groups:read",
        "channels:manage", "groups:write", "channels:join",
        "channels:write.topic", "groups:write.topic",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.channels", "message.groups", "message.im"]
    },
    "interactivity": {"is_enabled": false},
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
